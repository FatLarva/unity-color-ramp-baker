.readme-window {
    flex-grow: 1;
    min-height: 0;
}

.readme-header {
    flex-shrink: 0;
    padding: 20px 22px 16px;
}

.readme-heading-row {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}

.readme-title {
    font-size: 23px;
    -unity-font-style: bold;
    margin-right: 12px;
}

.readme-version {
    font-size: 11px;
    padding: 3px 7px;
    border-radius: 4px;
    background-color: rgba(128, 128, 128, 0.18);
}

.readme-description {
    white-space: normal;
    margin-top: 6px;
    margin-bottom: 12px;
    font-size: 13px;
}

.readme-actions {
    flex-direction: row;
    flex-wrap: wrap;
}

.readme-actions > Button {
    margin: 0 6px 4px 0;
    padding: 5px 12px;
}

.primary-action {
    -unity-font-style: bold;
}

.readme-scroll {
    flex-grow: 1;
    min-height: 0;
}

.readme-document {
    padding: 8px 22px 24px;
}

.readme-paragraph, .readme-list-text {
    white-space: normal;
    font-size: 13px;
    margin-bottom: 8px;
}

.readme-section {
    font-size: 19px;
    -unity-font-style: bold;
    margin-top: 18px;
    margin-bottom: 8px;
}

.readme-subsection {
    font-size: 15px;
    -unity-font-style: bold;
    margin-top: 12px;
    margin-bottom: 6px;
}

.readme-list-row {
    flex-direction: row;
}

.readme-list-marker {
    width: 22px;
    flex-shrink: 0;
    font-size: 13px;
}

.readme-list-text {
    flex-grow: 1;
    min-width: 0;
}

.readme-code {
    border-radius: 5px;
    background-color: rgba(128, 128, 128, 0.12);
    margin-top: 4px;
    margin-bottom: 12px;
    padding: 6px;
}

.readme-code-toolbar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
}

.readme-code-language {
    font-size: 10px;
    -unity-font-style: bold;
    margin-left: 5px;
}

.readme-code-field {
    margin: 0;
    font-size: 12px;
}

.readme-code-field .unity-text-field__input {
    border-width: 0;
    background-color: transparent;
    padding: 6px;
}

.readme-link {
    align-self: flex-start;
    margin: 0 0 8px;
    padding: 3px 10px;
}
